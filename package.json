{
  "name": "rattanava",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "oxlint src scripts test",
