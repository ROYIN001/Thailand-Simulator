  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "fast-check": "4.11.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "zod": "4.6.7"
  }
}
